pipeline {
    agent any

    triggers {
        githubPush()
    }

    environment {
        DOCKERHUB = 'wael75613/react-app'
        TAG = 'latest'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Setup') {
            steps {
                bat 'npm install'
            }
        }

        stage('Build') {
            steps {
                bat 'npm run build'
            }
        }

        stage('Run Docker') {
            steps {
                bat "docker build -t %DOCKERHUB%:%TAG% ."
            }
        }

        stage('Smoke Test') {
            steps {
                // Run container in background
                bat "docker run -d --name release-container -p 3002:80 %DOCKERHUB%:%TAG%"
                // Wait ~5 seconds safely in Windows
                bat "ping 127.0.0.1 -n 6 > nul"
                // Check if container is serving
                bat "curl -f http://localhost:3002 || exit 1"
            }
        }

        stage('Archive Artifacts') {
            steps {
                // Vite build folder is "dist"
                archiveArtifacts artifacts: 'dist/**'
            }
        }

        stage('Push to DockerHub') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'dockerhub-creds',
                                                 usernameVariable: 'DOCKER_USER',
                                                 passwordVariable: 'DOCKER_PASS')]) {
                    bat 'echo %DOCKER_PASS% | docker login -u %DOCKER_USER% --password-stdin'
                    bat 'docker push %DOCKERHUB%:%TAG%'
                }
            }
        }
    }

    post {
        always {
            // Cleanup container even if pipeline fails
            bat 'docker rm -f release-container || true'
        }
    }
}
