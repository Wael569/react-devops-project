pipeline {
    agent any

    triggers {
        // triggers only if pushing a tag
        gitlabPush(triggerOnTag: true)
    }

    environment {
        DOCKERHUB = 'wael75613/react-app'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Setup') {
            steps {
                bat 'npm install'
            }
        }

        stage('Build') {
            steps {
                bat 'npm run build'
            }
        }

        stage('Run Docker') {
            steps {
                bat 'docker build -t $DOCKERHUB:${GIT_TAG_NAME} .'
            }
        }

        stage('Smoke Test') {
            steps {
                bat 'docker run -d --name release-container -p 3002:80 $DOCKERHUB:${GIT_TAG_NAME}'
                bat 'sleep 5'
                bat 'curl -f http://localhost:3002 || exit 1'
            }
        }

        stage('Archive Artifacts') {
            steps {
                archiveArtifacts artifacts: 'dist/**'
            }
        }

        stage('Push to DockerHub') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'dockerhub-creds',
                                                 usernameVariable: 'wael75613',
                                                 passwordVariable: '13660341')]) {
                    bat 'echo "$PASS" | docker login -u "$USER" --password-stdin'
                    bat 'docker push $DOCKERHUB:${GIT_TAG_NAME}'
                }
            }
        }
    }

    post {
        always {
            bat 'docker rm -f release-container || true'
        }
    }
}
